# FeatherFlow backend — environment configuration.
# Copy to backend/.env (gitignored, never commit it) and fill in real values.
# Every variable a deployment actually needs is listed here — see
# OPERATIONS_RUNBOOK.md for the full local-setup and production-deployment
# walkthroughs.

# ── Core Django ───────────────────────────────────────────────────────────
# Local dev: True. Production: False (or simply unset — False is now the
# fail-safe default). DJANGO_SECRET_KEY is REQUIRED whenever DEBUG=False —
# the app refuses to start on the insecure placeholder in that case.
DJANGO_DEBUG=True
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (PostgreSQL) ────────────────────────────────────────────────
POSTGRES_DB=featherflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
POSTGRES_CONN_MAX_AGE=60

# ── Cache (Redis) ─────────────────────────────────────────────────────────
# Leave unset for local dev (falls back to an in-process cache). Production
# with more than one worker process/machine MUST set this — throttling,
# OTP codes, and any future @cache_page use are only correct with a cache
# shared across processes.
REDIS_URL=

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call this API from a browser
# (the Flutter web build's own origin, an admin console origin, etc.).
# REQUIRED in production — DEBUG=True keeps the old "allow everything" dev
# behaviour when this is left blank, but DEBUG=False + blank means "allow
# nothing" (fail closed), not "allow everything".
CORS_ALLOWED_ORIGINS=

# ── Realtime chat (Socket.IO, ASGI) ─────────────────────────────────────
SOCKET_IO_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080

# ── HTTPS / cookie hardening (production, behind TLS) ───────────────────
# Only turn these on once HTTPS actually terminates in front of this app
# (directly or via a reverse proxy) — see OPERATIONS_RUNBOOK.md. Turning on
# DJANGO_SECURE_SSL_REDIRECT without a working HTTPS front end will break
# every request with a redirect loop.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_TRUST_PROXY_SSL_HEADER=False
DJANGO_SESSION_COOKIE_SECURE=
DJANGO_CSRF_COOKIE_SECURE=
DJANGO_HSTS_SECONDS=0

# ── Email delivery ────────────────────────────────────────────────────────
# Local dev: leave EMAIL_BACKEND unset (defaults to the console backend —
# OTP/reset codes print to the terminal running the server). Production:
# set EMAIL_BACKEND to the SMTP backend explicitly and fill in the rest.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Featherflow <noreply@example.com>

# ── SMS / OTP delivery ────────────────────────────────────────────────────
# 'console' (default) — logs that a code was sent, and keeps it available to
# local dev tooling, but never prints the raw code to the log unless
# OTP_EXPOSE_CODES is also on. Set to a real provider name once
# verification/delivery.py::send_sms_code has an implementation for one.
SMS_BACKEND=console
# Exposes OTP codes in API responses (and, combined with SMS_BACKEND=console,
# in the log line) — for local manual QA ONLY. Defaults True in DEBUG, False
# otherwise; only override to force it off in a shared dev/staging box.
OTP_EXPOSE_CODES=
SIGNUP_REQUIRE_EMAIL_VERIFICATION=True
SIGNUP_REQUIRE_PHONE_VERIFICATION=False

# ── Rate limits (sane defaults baked into settings.py — override only if
#    you have a specific reason to) ────────────────────────────────────────
# THROTTLE_ADMIN_READ=600/min
# THROTTLE_ADMIN_WRITE=120/min
# THROTTLE_ADMIN_EXPORT=20/min
# THROTTLE_ADMIN_POLL=240/min
# THROTTLE_DISEASE_PREDICT=30/hour
# THROTTLE_AUTH_REGISTER=10/hour
# THROTTLE_AUTH_LOGIN=20/min
# THROTTLE_AUTH_UPLOAD=30/hour
# THROTTLE_OTP_REQUEST=15/hour
# THROTTLE_OTP_CONFIRM=30/hour
# THROTTLE_PASSWORD_RESET=10/hour
# THROTTLE_DOCUMENT_FETCH=120/hour
# THROTTLE_PROFILE_PHOTO=20/hour
# THROTTLE_PAYMENT_WRITE=60/hour
# THROTTLE_COMMUNITY_WRITE=60/min
# THROTTLE_COMMUNITY_REPORT=20/hour

# ── Payments / subscription billing ──────────────────────────────────────
# Leave every provider key below blank to stay in 'dev' mode (simulated
# checkout, the client picks success/failure/cancel, no real money moves).
# BILLING_MODE auto-upgrades to 'live' the instant ANY provider secret below
# is set — see PAYMENT_RUNBOOK.md (the full checklist before ever setting
# these for real) / PRODUCTION_READINESS_REPORT.md §7 / SECURITY_HARDENING_REPORT.md:
# 'live' mode currently has NO working provider integration (webhook
# signature verification is an intentional NotImplementedError stub) —
# do not set these in a real deployment until that work lands, or checkout
# will break for every user instead of processing real payments.
BILLING_MODE=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_PUBLIC_KEY=
NAGAD_BASE_URL=https://api.mynagad.com/api/dfs

# ── Consultations / video ────────────────────────────────────────────────
CONSULTATION_PLATFORM_THRESHOLD=1500.00
CONSULTATION_PLATFORM_RATE=5.00
# Video consultations open an external Jitsi Meet room — point this at a
# self-hosted Jitsi instance in production to keep calls private.
JITSI_BASE_URL=https://meet.jit.si

# ── Misc ──────────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
# Logging: 'json' for structured logs (production / log aggregators), unset
# for human-readable console output (local dev).
FF_LOG_FORMAT=
FF_LOG_LEVEL=INFO
